{
  "name": "portfolio-personal",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio (Next.js)",
  "author": "Jonas Yambao <jonas.paul11@yahoo.com>",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev --prefix next-app",
    "build": "npm ci --prefix next-app && npm run sync-content --prefix next-app && npm run build --prefix next-app",
    "typecheck": "npm run typecheck --prefix next-app",
    "verify-content": "npm run verify-content --prefix next-app",
    "start": "npm run start --prefix next-app",
    "lint": "npm run lint --prefix next-app",
    "test": "npm run test --prefix next-app",
    "sync-content": "npm run sync-content --prefix next-app",
    "lint-staged": "lint-staged",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,mjs}\"",
    "prepare": "husky install",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json,md,mjs}": [
      "prettier --write"
    ],
    "next-app/**/*.{js,jsx,ts,tsx}": [
      "npm run lint --prefix next-app -- --max-warnings=0"
    ]
  },
  "devDependencies": {
    "husky": "^6.0.0",
    "lint-staged": "^10.1.2",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
